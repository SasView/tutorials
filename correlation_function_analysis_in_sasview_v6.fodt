   <text:list text:style-name="L7">
    <text:list-item>
     <text:p text:style-name="P291">The real-space distance (in the inverse of the units of the input data)</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P292"><text:span text:style-name="T10">The value of </text:span><text:span text:style-name="T426">Γ</text:span><text:span text:style-name="T427">1</text:span><text:span text:style-name="T428">(z)</text:span></text:p>
    </text:list-item>
    <text:list-item>
