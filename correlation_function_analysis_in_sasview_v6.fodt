   <text:p text:style-name="P172"><text:span text:style-name="T211">The IDF is</text:span> a superposition of <text:span text:style-name="T161">the </text:span>thickness distributions from all the contributing lamellae.</text:p>
   <text:p text:style-name="P172"/>
   <text:p text:style-name="P169"><text:span text:style-name="T205"/></text:p>
   <text:p text:style-name="P173"><text:span text:style-name="T212">Aside:</text:span><text:span text:style-name="T10"> The transforms that SasView computes are:</text:span></text:p>
   <text:p text:style-name="P174"/>
