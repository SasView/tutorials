          AAAAAAAAAQD/AwAAAAAAAAAAAAAAiAABAAIAAAABAIcAAQAFAAAA/////wCGAAEABAAAAAAA
          AAByAAIAFwAAANgFAAAOAQAAAQBlawAAAAAAAQABAGUAjAABAAAAAACLAAEAAgAAAB8AigAB
          AEIAAAAFADwAAAAKAE9wZW5TeW1ib2wAAAAAAACQAAAA//8AAAAABQAAAAAAAAD/AwAAAAAA
          AAABAP8DAAAAAAAAAAAAAACIAAEAAgAAAAEAhwABAAUAAAD/////AIYAAQAEAAAAAAAAAHIA
          AgAaAAAARgYAAJYAAAABAAAAKAAxAAAAAAABAAEAKACMAAEAAAAAAIsAAQACAAAAHwCKAAEA
          QgAAAAUAPAAAAAoAT3BlblN5bWJvbAAAAAAAAJAAAAD//wAAAAAFAAAAAAAAAP8DAAAAAAAA
          AAEA/wMAAAAAAAAAAAAAAIgAAQACAAAAAQCHAAEABQAAAP////8AhgABAAQAAAAAAAAAcgAC
          ABoAAAB2BgAAlgAAAAEAAAASInIAAAAAAAEAAQASIowAAQAAAAAAiwABAAIAAAAfAIoAAQBI
          AAAABQBCAAAAEABMaWJlcmF0aW9uIFNlcmlmAAAAAAAAkAAAAAAAAAAAAAUAAAAAAAIA/wMA
          AAAAAAAAAQD/AwAAAAAAAAAAAAAAiAABAAIAAAABAIcAAQAFAAAA/////wCGAAEABAAAAAAA
          AAByAAIAFwAAAO8GAACWAAAAAQA/RwAAAAAAAQABAMMDjAABAAAAAACLAAEAAgAAAB8AigAB
          AEgAAAAFAEIAAAAQAExpYmVyYXRpb24gU2VyaWYAAAAAAABWAAAAAAAAAAAABQAAAAAAAAD/
          AwAAAAAAAAABAP8DAAAAAAAAAAAAAACIAAEAAgAAAAEAhwABAAUAAAD/////AIYAAQAEAAAA
          AAAAAHIAAgAXAAAARAcAAE4AAAABADIrAAAAAAABAAEAMgCMAAEAAAAAAIsAAQACAAAAHwCK
          AAEASAAAAAUAQgAAABAATGliZXJhdGlvbiBTZXJpZgAAAAAAAJAAAAAAAAAAAAAFAAAAAAAC
          AP8DAAAAAAAAAAEA/wMAAAAAAAAAAAAAAIgAAQACAAAAAQCHAAEABQAAAP////8AhgABAAQA
          AAAAAAAAcgACABcAAACABwAAlgAAAAEALiQAAAAAAAEAAQAuAIwAAQAAAAAAiwABAAIAAAAf
          AIoAAQBIAAAABQBCAAAAEABMaWJlcmF0aW9uIFNlcmlmAAAAAAAAkAAAAAAAAAAAAAUAAAAA
          AAIA/wMAAAAAAAAAAQD/AwAAAAAAAAAAAAAAiAABAAIAAAABAIcAAQAFAAAA/////wCGAAEA
          BAAAAAAAAAByAAIAFwAAALIHAACWAAAAAQBRaAAAAAAAAQABAFEAjAABAAAAAACLAAEAAgAA
          AB8AigABAEgAAAAFAEIAAAAQAExpYmVyYXRpb24gU2VyaWYAAAAAAABWAAAAAAAAAAAABQAA
          AAAAAAD/AwAAAAAAAAABAP8DAAAAAAAAAAAAAACIAAEAAgAAAAEAhwABAAUAAAD/////AIYA
          AQAEAAAAAAAAAHIAAgAXAAAAIQgAAE4AAAABADIrAAAAAAABAAEAMgCMAAEAAAAAAIsAAQAC
          AAAAHwCKAAEAQgAAAAUAPAAAAAoAT3BlblN5bWJvbAAAAAAAAJAAAAD//wAAAAAFAAAAAAAA
          AP8DAAAAAAAAAAEA/wMAAAAAAAAAAAAAAIgAAQACAAAAAQCHAAEABQAAAP////8AhgABAAQA
          AAAAAAAAcgACABoAAABTCAAAlgAAAAEAAAApADEAAAAAAAEAAQApAIwAAQAAAAAAiwABAAIA
          AAAfAIoAAQBCAAAABQA8AAAACgBPcGVuU3ltYm9sAAAAAAAA8AAAAP//AAAAAAUAAAAAAAAA
