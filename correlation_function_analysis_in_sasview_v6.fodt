   <text:p text:style-name="P185">The integral breadth of a correlation function is <text:span text:style-name="T11">called</text:span> the correlation length:</text:p>
   <text:p text:style-name="P185"/>
   <text:p text:style-name="P179"><text:span text:style-name="T224"><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/><text:tab/></text:span><text:span text:style-name="T224"><draw:frame draw:style-name="fr2" draw:name="Object7" text:anchor-type="as-char" svg:y="-0.596cm" svg:width="5.263cm" svg:height="1.057cm" draw:z-index="14"><draw:object>
