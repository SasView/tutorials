   <text:p text:style-name="P79"/>
   <text:p text:style-name="P79"/>
   <text:p text:style-name="P80"/>
   <text:p text:style-name="P81">Example <text:span text:style-name="T55">1</text:span></text:p>
   <text:p text:style-name="P82"/>
   <table:table table:name="Table10" table:style-name="Table10">
    <table:table-column table:style-name="Table10.A"/>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="P83">This <text:span text:style-name="T56">computes the correlation function from a quasi-lamellar system and then interprets that correlation function to extract parameters characterising the underlying nanostructure. </text:span><text:span text:style-name="T57">This is a typical use case</text:span><text:span text:style-name="T56">.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P84"/>
   <text:p text:style-name="P85">In the Data Explorer panel, click the <text:span text:style-name="T58">Load Data</text:span> button, and navigate to the <text:span text:style-name="T59">\</text:span><text:span text:style-name="T60">example_data</text:span><text:span text:style-name="T61">\1d_data </text:span>folder in the SasView installation directory.</text:p>
   <text:p text:style-name="P86">Select the <text:span text:style-name="T62">ISIS_</text:span><text:span text:style-name="T63">98929</text:span><text:span text:style-name="T64">.</text:span><text:span text:style-name="T63">txt</text:span> dataset <text:span text:style-name="T65">and click the </text:span><text:span text:style-name="T66">Open</text:span><text:span text:style-name="T65"> button.</text:span></text:p>
   <text:p text:style-name="P86"/>
   <text:p text:style-name="P87"><draw:frame draw:style-name="fr4" draw:name="Image2" text:anchor-type="char" svg:width="17cm" svg:height="9.22cm" draw:z-index="25"><draw:image draw:mime-type="image/png">
