   <text:p text:style-name="P126"/>
   <text:p text:style-name="P121"/>
   <text:p text:style-name="P130">If you uncheck any of these boxes, you will need to supply the relevant information in the <text:span text:style-name="T30">Extrapolation Parameters</text:span> section of the Corfunc Perspective <text:span text:style-name="T11">(see the previous </text:span><text:span text:style-name="T68">Aside</text:span><text:span text:style-name="T11"> box)</text:span>.</text:p>
   <text:p text:style-name="P130"/>
