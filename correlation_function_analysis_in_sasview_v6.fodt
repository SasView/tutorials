   <text:p text:style-name="P279"><text:span text:style-name="T416">As can be seen, t</text:span>he agreement is actually quite <text:span text:style-name="T339">reasonable</text:span>! But the important point here is that the SANS-derived correlation functions are averaged over a far larger <text:span text:style-name="T416">gauge volume </text:span>(mm<text:span text:style-name="T417">3</text:span><text:span text:style-name="T418">) c</text:span><text:span text:style-name="T147">ompared to </text:span><text:span text:style-name="T418">that from the STEM-EELS measurements</text:span><text:span text:style-name="T147"> </text:span><text:span text:style-name="T418">(</text:span><text:span text:style-name="T147">nm</text:span><text:span text:style-name="T419">3</text:span><text:span text:style-name="T147">).</text:span></text:p>
   <text:p text:style-name="P280"/>
   <text:p text:style-name="P280"/>
   <text:p text:style-name="P280"/>
   <text:p text:style-name="P278">Further Information</text:p>
   <text:p text:style-name="P281"/>
   <text:p text:style-name="P282">For further information, please consult <text:span text:style-name="T420">the</text:span></text:p>
   <text:p text:style-name="P282"/>
   <text:p text:style-name="P283">SasView Tutorial Series</text:p>
   <text:p text:style-name="P284"/>
   <text:p text:style-name="P284">or</text:p>
   <text:p text:style-name="P285"/>
   <text:p text:style-name="P283"><text:a xlink:type="simple" xlink:href="http://www.sasview.org/" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link">http://www.sasview.org</text:a></text:p>
   <text:p text:style-name="P284"/>
   <text:p text:style-name="P284">or email</text:p>
   <text:p text:style-name="P284"/>
   <text:p text:style-name="P283"><text:a xlink:type="simple" xlink:href="mailto:help@sasview.org" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link">help@sasview.org</text:a></text:p>
   <text:p text:style-name="P286"/>
   <text:p text:style-name="P286"/>
   <text:p text:style-name="P287">A<text:span text:style-name="T421">ppendix</text:span></text:p>
   <text:p text:style-name="P288"/>
   <text:p text:style-name="P289">C<text:span text:style-name="T421">licking the </text:span><text:span text:style-name="T422">Export Transformed</text:span><text:span text:style-name="T421"> button in the </text:span><text:span text:style-name="T339">Corfunc Perspective</text:span><text:span text:style-name="T421"> window writes a </text:span><text:span text:style-name="T423">comma</text:span><text:span text:style-name="T424">-</text:span><text:span text:style-name="T423">separated</text:span><text:span text:style-name="T425"> text file with the extension .</text:span><text:span text:style-name="T376">csv</text:span><text:span text:style-name="T425">.</text:span></text:p>
   <text:p text:style-name="P290"/>
