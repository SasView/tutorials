   <text:p text:style-name="P183"><text:span text:style-name="T10">where </text:span><text:span text:style-name="T219">Γ</text:span><text:span text:style-name="T195">1</text:span><text:span text:style-name="T196">(0) = </text:span><text:span text:style-name="T194">Γ</text:span><text:span text:style-name="T195">3</text:span><text:span text:style-name="T196">(0) = 1, </text:span><text:span text:style-name="T220">and g</text:span><text:span text:style-name="T221">1</text:span><text:span text:style-name="T220">(0) </text:span><text:span text:style-name="T222">≥</text:span><text:span text:style-name="T223"> 0.</text:span></text:p>
