   <text:p text:style-name="P274">Azimuthally integrated and averaged profiles of <text:span text:style-name="T404">the </text:span>Cr/Fe L3-edge ratio map<text:span text:style-name="T404">s from alloy specimens</text:span><text:span text:style-name="T410"> </text:span></text:p>
   <text:p text:style-name="P274"><text:span text:style-name="T411">a</text:span><text:span text:style-name="T410">ged at 475 C for 100 h</text:span><text:span text:style-name="T412">ours. Figure reproduced from Fig </text:span><text:span text:style-name="T411">10</text:span><text:span text:style-name="T412"> in Xu et al, Acta Mat., (2</text:span><text:span text:style-name="T411">017).</text:span></text:p>
   <text:p text:style-name="P275"/>
   <text:p text:style-name="P276"><text:span text:style-name="T413">F</text:span><text:span text:style-name="T414">or comparison, here are the </text:span><text:span text:style-name="T415">(replotted)</text:span><text:span text:style-name="T414"> correlation functions </text:span><text:span text:style-name="T415">as </text:span><text:span text:style-name="T414">computed using SasView </text:span><text:span text:style-name="T415">5.x</text:span><text:span text:style-name="T414">:</text:span></text:p>
   <text:p text:style-name="P277"/>
