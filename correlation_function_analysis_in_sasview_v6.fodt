         AACMAAEAAAAAAA==
        </office:binary-data>
       </draw:image>
      </draw:frame>? <text:span text:style-name="T252">(ie, corresponding to the truncation point of the Fourier Transform)</text:span></text:p>
     <text:list>
      <text:list-item>
       <text:p text:style-name="P191">This example: No (Q<text:span text:style-name="T253">max</text:span><text:span text:style-name="T147"> </text:span><text:span text:style-name="T254">for this dataset was 0.285 </text:span><text:span text:style-name="T255">Å</text:span><text:span text:style-name="T256">-</text:span><text:span text:style-name="T257">1</text:span><text:span text:style-name="T254"> so the period of these ripples would be ~0.2 </text:span><text:span text:style-name="T255">Å</text:span><text:span text:style-name="T254">)</text:span></text:p>
      </text:list-item>
     </text:list>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P192"><text:span text:style-name="T245">Are there ‘ripples’ in </text:span><text:span text:style-name="T248">Γ</text:span><text:span text:style-name="T249">1</text:span><text:span text:style-name="T250">(z) &amp; </text:span><text:span text:style-name="T248">Γ</text:span><text:span text:style-name="T251">3</text:span><text:span text:style-name="T250">(z) </text:span><text:span text:style-name="T245">with a period of</text:span><draw:frame draw:style-name="fr2" draw:name="Object11" text:anchor-type="as-char" svg:y="-0.377cm" svg:width="1.466cm" svg:height="0.534cm" draw:z-index="21"><draw:object>
        <math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
         <semantics>
          <mrow>
           <mn>2</mn>
           <mrow>
            <mi>π</mi>
            <mo stretchy="false">/</mo>
            <msub>
             <mi>Q</mi>
             <mi mathvariant="italic">max</mi>
            </msub>
           </mrow>
          </mrow>
          <annotation encoding="StarMath 5.0">2%pi / Q_max </annotation>
         </semantics>
        </math>
       </draw:object><draw:image>
        <office:binary-data>VkNMTVRGAQAxAAAAAAAAAAEAGwAAAAkAAAAAAAAAAAABAAAAAQAAAAEAAAABAAAAAT8DAAAv
