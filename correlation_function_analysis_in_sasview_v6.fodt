           <mo fence="true" form="postfix" stretchy="false">)</mo>
          </mrow>
          <mi mathvariant="italic">dz</mi>
         </mrow>
         <annotation encoding="StarMath 5.0">correlation length = 2 int from{ 0 } to{ infinity } %GAMMA ( z ) dz </annotation>
        </semantics>
       </math>
