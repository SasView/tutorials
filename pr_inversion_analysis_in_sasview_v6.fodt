   <text:p text:style-name="P60"><text:soft-page-break/>Example <text:span text:style-name="T29">1</text:span></text:p>
   <text:p text:style-name="P61"/>
   <table:table table:name="Table10" table:style-name="Table10">
    <table:table-column table:style-name="Table10.A"/>
    <table:table-row>
     <table:table-cell table:style-name="Table10.A1" office:value-type="string">
      <text:p text:style-name="P62">This <text:span text:style-name="T30">computes the distance distribution function for the glycoprotein conalbumin.</text:span></text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <text:p text:style-name="P63"/>
   <text:p text:style-name="P64">In the Data Explorer panel, click the <text:span text:style-name="T31">Load Data</text:span> button, and navigate to the <text:span text:style-name="T32">\example_data</text:span><text:span text:style-name="T33">\1d_data </text:span>folder in the SasView installation directory.</text:p>
   <text:p text:style-name="P64"/>
   <text:p text:style-name="P65">Select the <text:span text:style-name="T34">conalbumin.txt</text:span> dataset <text:span text:style-name="T35">and click the </text:span><text:span text:style-name="T36">Open</text:span><text:span text:style-name="T35"> button.</text:span></text:p>
